{
  "extends": "./.void/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "skipLibCheck": true,
    "types": ["void/env"]
  },
  "include": ["src", "pages", "routes", "durable-objects", "void.config.ts", "vite.config.ts"]
}
